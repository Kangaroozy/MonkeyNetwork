# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
CLASH_DATABASE_URL=       # Optional: separate Clash DB connection string (leave empty to disable Clash features)

# ── Clash Auth ─────────────────────────────────────────────────
CLAN_ADMIN_USERNAMES=     # Optional comma-separated minecraft usernames with admin role on registration

# ── App/Auth ───────────────────────────────────────────────────
APP_BASE_URL=             # e.g. https://your-site.com
SESSION_COOKIE_NAME=mn_session
SESSION_TTL_SECONDS=1209600

# ── Plugin Sync ────────────────────────────────────────────────
CLASH_PLUGIN_SYNC_TOKEN=  # Shared token for plugin roster sync endpoint
